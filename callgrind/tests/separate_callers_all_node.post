#! /bin/sh

# Count native contexts that call both calleeX and calleeY. JIT functions are
# named by address in the callgrind output; node's perf map resolves them.

out=callgrind.out.separate_callers_all_node
pid=$(awk '/^pid:/ { print $2; exit }' "$out")
map=/tmp/perf-$pid.map

addrs() {
  awk -v fn="JS:^$1" '$3 == fn { a = $1; while (length(a) < 16) a = "0" a; print "0x" a }' "$map"
}

callers() {
  ./print_calls "$out" | awk -v addrs="$(addrs "$1")" '
    BEGIN { n = split(addrs, a, "\n"); for (i = 1; i <= n; i++) want[a[i]] = 1 }
    $1 !~ /^0x/ { split($3, c, "'"'"'"); if (c[1] in want) print $1 }' | sort -u
}

for fn in calleeX calleeY; do
  [ -n "$(addrs $fn)" ] || echo "$fn missing from $map"
done
callers calleeX > callers.x
callers calleeY > callers.y
echo "native contexts calling both callees: $(comm -12 callers.x callers.y | wc -l)"
rm -f callers.x callers.y "$map"
